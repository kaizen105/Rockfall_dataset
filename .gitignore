# Python environments & caches
venv/
env/
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/

# IDE & Editor configurations (contain machine-specific absolute paths)
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Data directory rules: ignore archive & active releases, whitelist inputs
data/archive/
data/inputs/weather_dataset.csv
data/current/*/*
!data/current/v1d_s1/location_metadata.csv

# Ignore large/generated CSVs, whitelist essential small metadata & inputs
*.csv
!spatial_metadata.csv
!data/inputs/spatial_metadata.csv
!data/inputs/geometry_dataset_500.csv
!data/current/v1d_s1/location_metadata.csv
!qgis_raw_data/*.csv
!data/README.md

# Intermediate generation parts & checkpoints
*/parts/
*_rng.pkl
part_*.csv

# Scratch analysis files & temporary logs
scratch/
*.log
task-*.log
temp/
tmp/

# OS-specific clutter
Thumbs.db
Desktop.ini
.DS_Store
